# Plantilla del archivo .env. Copiala como .env (en esta misma carpeta) y llena
# los valores reales. El .env nunca se sube al repositorio: lo cubre .gitignore.
#
# Este unico archivo alimenta tanto los scripts de Python como el backend del
# dashboard en dashboard-web/.

# Correo de Gmail que recibe las notificaciones de Nequi.
GMAIL_ACCOUNT=tucorreo@gmail.com

# Contrasena de aplicacion de Google (NO la contrasena normal de la cuenta).
# Se genera en https://myaccount.google.com/apppasswords
# Requiere tener la verificacion en dos pasos activada.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Cadena de conexion de Neon. Usa la opcion "Pooled connection".
NEON_CONEXION_STR=postgresql://usuario:clave@ep-algo-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Rama de prueba de Neon (opcional). La usan:
#   npm run migrar:prueba   aplica las migraciones ahi antes que en la real
#   npm run dev:prueba      levanta el tablero contra esa rama
NEON_CONEXION_STR_PRUEBA=postgresql://usuario:clave@ep-otra-rama-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Puerto del backend del dashboard. Si lo cambias, ajusta tambien el proxy en
# dashboard-web/frontend/vite.config.js.
PORT=3001

# --- Opcionales del dashboard -------------------------------------------------

# Meta diaria inicial, solo mientras no exista la tabla configuracion. Despues
# se cambia desde Configuracion > Meta diaria.
# META_DIARIA=600000

# Cuantos dias hacia atras se pueden consultar en Reportes > Ventas totales.
# VENTAS_MAX_DIAS=60
